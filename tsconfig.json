{
  "include": ["app/javascript"],
  "compilerOptions": {
    // Based on: https://bun.com/docs/typescript#suggested-compileroptions

    // Environment setup & latest features
    "lib": ["DOM", "ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "allowImportingTsExtensions": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    // Custom instructions
    "noImplicitAny": false, // We use a lot of third-party libraries without proper typings
    "verbatimModuleSyntax": false, // Required for correct type imports from node_modules
    "noImplicitOverride": false // Stimulus controllers often override methods without the override keyword, e.g. connect() or disconnect()
  }
}
