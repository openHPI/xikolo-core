#course-list__content.dashboard
  - @categories.each_with_index do |category, index|
    .course-group
      h2.h2.category-title
        = category.title
      - if category.courses.empty?
        = render Global::Callout.new category.empty_msg
      - else
        div class="grid grid-cols-1 gap-8 mt-1 mb-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" data-id = "category-#{index}"
          - category.courses.each do |course|
            = render Home::CourseCard.new(course, enrollment: @enrollments[course.id])
  = render Global::Callout.new(t(:'dashboard.more_courses'))

- content_for :sidebar
  = render 'dashboard/overview_sidebar'
