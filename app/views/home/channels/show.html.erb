<% content_for :page_header do %>
  <%= render 'home/channels/header', channel: @channel %>
<% end %>

<div id="channel-courses" class="scroll-mt-navbar">
  <% if @channel.info_link? %>
    <div class="show-more-link">
      <%= link_to @channel.info_link_url, class: 'bs-a' do %>
        <%= @channel.info_link_label %>
        <%= render Global::FaIcon.new('circle-info') %>
      <% end %>
    </div>
  <% end %>

  <div data-hide-on-submit="#course-list__content" data-show-on-submit="#course-list__loading">
    <%= render Home::Channel::FilterBar.new(user: current_user, results_count: @course_list.courses_count) %>

    <div id="course-list__loading" hidden>
      <%= render State::Loading.new(t(:'course.courses.index.loading')) %>
    </div>

    <div id="course-list__content" class="course-list__content">
      <% if @categories.any? %>
        <% @categories.each_with_index do |category, index| %>
          <div class="course-group">
            <h2 class="h2 category-title">
              <%= category.title %>
            </h2>
            <div class="grid grid-cols-1 gap-8 mt-1 mb-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" data-id="category-<%= index %>">
              <%= render partial: 'home/courses/courses', locals: {courses: category.courses, enrollments: @enrollments} %>
            </div>

            <%# Only self-paced courses are paginated so far, so there is a `next_page` for them. %>
            <% if category.courses.respond_to?(:next_page) && category.courses.next_page.present? %>
              <div class="load-more">
                <%= button_tag(type: 'button', class: 'btn btn-default btn-outline mb20 mt20',
                  data: {behavior: 'load-more', current_page: category.courses.current_page, target: "category-#{index}"}) do %>
                  <%= t(:'course.courses.index.load_more') %>
                <% end %>
                <div data-id="load-more__indicator" hidden>
                  <%= render State::Loading.new %>
                </div>
                <p data-id="load-more__error-message" hidden>
                  <%= t(:'course.courses.index.error') %>
                </p>
              </div>
            <% end %>
          </div>
        <% end %>
      <% elsif request.GET.empty? %>
        <%# Check if the course list has been filtered and only then show a call to action button to reset all filters. %>
        <%= render State::Empty.new(t(:'channels.show.empty_state')) %>
      <% else %>
        <%= render State::Empty.new(t(:'channels.show.empty')) do %>
          <%= link_to t(:'course.courses.index.action'), channel_path(@channel.code),
            data: {'hide-on-click': '#course-list__content', 'show-on-click': '#course-list__loading'},
            class: 'btn btn-primary mt10' %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% unless @channel.description.blank? %>
    <div
      class="channel-info"
      data-controller="read-more"
      data-read-more-clamped-class="line-clamp-12"
    >
      <h2 class="mb-4 text-xl font-medium">
        <%= t('channels.show.more_information') %>
      </h2>

      <div
        id="channel-description"
        class="
          channel-explanation prose prose-sm mb-2.5 line-clamp-12
          max-w-none
        "
        data-read-more-target="content"
      >
        <%== render_markdown(@channel.description, allow_tables: true) %>
      </div>

      <button
        type="button"
        class="cursor-pointer pt-2.5"
        data-read-more-target="button"
        data-action="read-more#toggle"
        aria-controls="channel-description"
        aria-expanded="false"
        hidden
      >
        <span data-read-more-target="moreLabel">
          <%= t(:'global.read_more') %>
          <%= render Global::FaIcon.new('angles-down', css_classes: 'ml5') %>
        </span>

        <span data-read-more-target="lessLabel" hidden>
          <%= t(:'global.read_less') %>
          <%= render Global::FaIcon.new('angles-up', css_classes: 'ml5') %>
        </span>
      </button>
    </div>
  <% end %>

   <% if @channel.other_channels.any? %>
    <div class="mt-4 mx-auto max-w-main-content p-6">
      <header class="w-full justify-center text-2xl font-medium text-base-content">
        <h2 id="other-channels" class="font-medium mr-2">
          <%= t(:'channels.other_channels') %>
        </h2>
      </header>
      <%= render Home::Channel::List.new(items: @channel.other_channels) %>
    </div>
  <% end %>

</div>
