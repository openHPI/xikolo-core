- content_for :head_assets

= render 'course/shared/admin_page_header', title: t(:'admin.statistics.pinboard.title')

.bs-container.white-bg.statistics-page
  .row
    .col-md-6
      = render Global::Table.new(rows: @most_active_table_rows, headers: @most_active_table_headers, title: t(:'admin.statistics.pinboard.most_active.title')) do |table|
        - table.column(:user) do |row|
          = link_to(row[:user]['name'], "/users/#{row[:user]['id']}", class: 'bs-a')
