<%# The header of a course administration page: the page itself as the title,
    the course it belongs to as the subtitle. See app/components/docs/page_header.md.erb. %>
<% content_for :course_area_header do %>
  <%= render Global::PageHeader.new(title, subtitle: course_layout.title) do %>
    <%= render 'course/shared/course_admin_action', course: course_layout, in_teacher_context: true %>
  <% end %>
<% end %>
