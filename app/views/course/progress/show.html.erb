<% if @course_progress.present? %>
  <div class="relative px-3.75 lg:px-16">
    <%# Extends the page header background so the progress header overlaps it %>
    <div class="bg-accent-25 absolute inset-x-0 top-0 h-12" aria-hidden="true"></div>
    <div class="relative container mx-auto">
      <%= render Course::LearnerProgress::Header.new(
        progress: @completed_items_progress,
        certificates_url: ('#progress-certificates-title' if @certificates.any?),
      ) %>
    </div>
  </div>
<% end %>

<div class="mt-3.75 px-3.75 lg:px-16">
  <div class="container mx-auto">
    <% if @course_progress.present? %>
      <%= render Course::LearnerProgress::Sections.new(
        @course_progress,
        @course,
        current_item_id: @current_item&.id,
        locked_item_ids: @quiz_list.locked_item_ids,
        retakable_item_ids: @quiz_list.retakable_item_ids,
        exam_unlock_percentage: @quiz_list.exam_unlock_percentage,
      ) %>
    <% else %>
      <p><%= t(:'course.progress.show.empty_msg') %></p>
    <% end %>

    <% if @quiz_list.any? %>
      <section class="text-base-content flex flex-col gap-4 py-8" aria-labelledby="progress-quizzes-title">
        <h2 id="progress-quizzes-title" class="text-xl font-medium lg:text-2xl">
          <%= t(:'.quizzes_title') %>
        </h2>

        <%= render Global::Carousel.new(label: t(:'.quizzes_title'), size: :sm) do |carousel| %>
          <% @quiz_list.each do |quiz| %>
            <% carousel.with_item do %>
              <%= render Course::ItemCard.new(
                title: quiz.title,
                label: quiz.label,
                icon: quiz.icon,
                path: quiz.path,
                state: quiz.state,
              ) %>
            <% end %>
          <% end %>
        <% end %>
      </section>
    <% end %>

    <% if @optional_items.any? %>
      <section class="text-base-content flex flex-col gap-4 py-8" aria-labelledby="progress-optional-items-title">
        <h2 id="progress-optional-items-title" class="text-xl font-medium lg:text-2xl">
          <%= t(:'course.progress.show.optional_items_title') %>
        </h2>

        <%= render Global::Carousel.new(label: t(:'course.progress.show.optional_items_title'), size: :sm) do |carousel| %>
          <% @optional_items.each do |item| %>
            <% carousel.with_item do %>
              <%= render Course::ItemCard.new(
                title: item.title,
                label: item.label,
                icon: item.icon,
                path: item.path,
                state: item.state,
              ) %>
            <% end %>
          <% end %>
        <% end %>
      </section>
    <% end %>
  </div>
</div>

<% if @certificates.any? %>
  <section class="bg-secondary-10 text-base-content px-3.75 py-8 lg:px-16 lg:pt-16" aria-labelledby="progress-certificates-title">
    <div class="container mx-auto flex flex-col gap-4 lg:gap-8">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between lg:gap-8">
        <div class="flex flex-col gap-1 lg:gap-2">
          <h2 id="progress-certificates-title" class="text-xl font-semibold lg:text-3xl">
            <%= t(:'course.progress.show.certificates_title') %>
          </h2>
          <p class="text-sm lg:text-xl"><%= t(:'course.progress.show.certificates_subtitle') %></p>
        </div>

        <%# Page-specific positioning lets the mascot peek out from behind the certificate cards. %>
        <div class="-mb-8 max-w-full self-end lg:-mb-14 lg:shrink-0">
          <%= render Global::Mascot.new(message: @certificates.mascot_message) %>
        </div>
      </div>

      <div class="relative grid gap-4 lg:grid-cols-2 lg:gap-8">
        <% @certificates.cards.each do |certificate| %>
          <%= render Course::CertificateCard.new(
            title: certificate.title,
            description: certificate.description,
            requirement: certificate.requirement,
            issued_on: certificate.issued_on,
            achieved: certificate.achieved?,
            download_path: certificate.download_path,
          ) %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<%= render 'course/shared/bottom_bar', course_id: course_layout.id %>
