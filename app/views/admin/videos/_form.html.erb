<% stream ||= Video::Stream.new %>
<%= form_with(model: stream, url: videos_path, method: :post,
      html: {multipart: true}) do |f| %>
  <div class="flex flex-col gap-5">
    <div class="flex flex-col gap-1.5">
      <%= f.label :title, t(:'admin.videos.form.title'), class: 'x-label' %>
      <%= f.text_field :title, class: 'x-input', placeholder: t(:'admin.videos.form.title') %>
    </div>

    <div class="flex flex-col gap-1.5">
      <%= render Form::FileUpload.new(f, :video,
            icon: 'video',
            title: t(:'admin.videos.form.video.title'),
            hint: t(:'admin.videos.form.video.hint'),
            button_label: t(:'admin.videos.form.video.button'),
            accept: 'video/*',
            direct_upload: true,
            required: true) %>
    </div>
  </div>

  <%= f.submit t(:'admin.videos.form.submit'), class: 'mt-5 x-btn x-btn-primary' %>
<% end %>
