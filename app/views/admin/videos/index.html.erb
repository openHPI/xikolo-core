<% content_for :page_header do %>
  <%= render Global::PageHeader.new(t(:'admin.videos.index.headline'), subtitle: t(:'admin.page_header')) %>
<% end %>

<div class="bs-container">
  <div class="row">
    <div class="col-md-12 pt10">
      <div class="filter mb20">
        <div class="mb10 pull-right">
          <%= link_to t(:'admin.videos.index.upload'), new_video_path, class: 'btn btn-primary mr10' %>
          <%= link_to t(:'admin.video_providers.title'), admin_video_providers_path, class: 'bs-a mr10' %>
        </div>
        <%= form_tag videos_path, method: :get do %>
          <%= label :video_filter, :prefix, t(:'admin.videos.index.filter_videos') %>
          <%= search_field_tag 'prefix', params[:prefix], id: 'video_filter_prefix', class: 'px-2 py-1 border rounded' %>
          <%= submit_tag t(:'admin.videos.index.search'), class: 'bg-gray-600 px-2 py-1 rounded text-white hover:bg-gray-800 focus:bg-gray-800' %>
        <% end %>
      </div>
      <table class="table table-striped table-condensed table-hover" id="video-list">
        <tr>
          <th><%= t(:'admin.videos.index.provider') %></th>
          <th>
            <%= t(:'admin.videos.index.title') %>
            <% if params[:prefix].present? %>
              <%= render Global::FaIcon.new('arrow-up-wide-short', style: :solid) %>
            <% end %>
          </th>
          <th><%= t(:'admin.videos.index.status') %></th>
          <th><%= t(:'admin.videos.index.dimensions') %></th>
          <th><%= t(:'admin.videos.index.duration') %></th>
          <th>
            <%= t(:'admin.videos.index.created_at') %>
            <% if params[:prefix].blank? %>
              <%= render Global::FaIcon.new('arrow-up-wide-short', style: :solid) %>
            <% end %>
          </th>
          <th><%= t(:'admin.videos.index.quality') %></th>
          <th></th>
        </tr>
        <% @streams.each do |stream| %>
          <tr class="stream">
            <td class="video-list__provider"><%= stream.provider_name %></td>
            <td><%= stream.title %></td>
            <td><%= upload_status_badge(stream) %></td>
            <td><%= "#{stream.width} x #{stream.height}" %></td>
            <td><%= Duration.new(stream.duration) %></td>
            <td><%= stream.created_at.to_time %></td>
            <td>
              <% if stream.hd_url %>
                <%= link_to t(:'admin.videos.index.hd_stream'), stream.hd_url, target: '_blank', rel: 'noopener', class: 'label label-default mr5' %>
              <% else %>
                <div class="label mr5 invisible">
                  <%= t(:'admin.videos.index.hd_stream') %>
                </div>
              <% end %>
              <% if stream.sd_url %>
                <%= link_to t(:'admin.videos.index.sd_stream'), stream.sd_url, target: '_blank', rel: 'noopener', class: 'label label-default mr5' %>
              <% else %>
                <div class="label mr5 invisible">
                  <%= t(:'admin.videos.index.sd_stream') %>
                </div>
              <% end %>
              <% if stream.hls_url %>
                <%= link_to t(:'admin.videos.index.hls_stream'), stream.hls_url, target: '_blank', rel: 'noopener', class: 'label label-default' %>
              <% else %>
                <div class="label invisible">
                  <%= t(:'admin.videos.index.hls_stream') %>
                </div>
              <% end %>
            </td>
            <td>
              <%= render Global::ActionsDropdown.new(menu_side: 'right') do |c| %>
                <% c.with_action do %>
                  <%= copy_id_button(stream) %>
                <% end %>
                <% if stream.tracks_upload? && stream.failed? %>
                  <% c.with_action do %>
                    <%= link_to retry_video_path(stream.id), class: 'bs-a', method: 'post', data: {confirm: t(:'admin.videos.index.confirm_retry'), disable_with: t(:'admin.videos.index.retrying')} do %>
                      <%= t(:'admin.videos.index.retry') %>
                      <%= render Global::FaIcon.new('rotate') %>
                    <% end %>
                  <% end %>
                <% end %>
                <% c.with_action do %>
                  <%= link_to stream_sync_path(stream['id']), class: 'bs-a', method: 'post', data: {show_on_click: '#loading-dimmer'} do %>
                    <%= t(:'admin.videos.index.sync') %>
                    <%= render Global::FaIcon.new('rotate') %>
                  <% end %>
                <% end %>
                <% c.with_destructive_action do %>
                  <%= link_to video_path(stream.id), class: 'bs-a', method: 'delete', data: {confirm: t(:'admin.videos.index.confirm'), disable_with: t(:'admin.videos.index.deleting')} do %>
                    <%= t(:'admin.videos.index.delete') %>
                    <%= render Global::FaIcon.new('trash-can') %>
                  <% end %>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </table>
      <%= render Global::Pagination.new(@streams) %>
    </div>
  </div>
</div>
