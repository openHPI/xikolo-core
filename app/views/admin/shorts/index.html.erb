<% content_for :page_header do %>
  <%= render Global::PageHeader.new(t(:'admin.shorts.index.headline'), subtitle: t(:'admin.page_header')) %>
<% end %>

<section class="mx-auto max-w-342.5 px-4 py-8">
  <div class="flex flex-col gap-2 md:flex-row md:items-center p-4 mb-4 x-rounded-box border border-base-300 bg-base-100 text-base-content shadow-xs">
    <div class="order-2 min-w-0 flex-1 md:order-1" data-hide-on-submit="#admin-shorts__content" data-show-on-submit="#admin-shorts__loading">
      <%= render Admin::Short::FilterBar.new %>
    </div>
    <div class="order-1 md:order-2 md:ml-auto">
      <% if current_user.allowed? 'course.short.create' %>
        <%= link_to t(:'admin.shorts.index.create'), new_admin_short_path, class: 'x-btn x-btn-primary w-full md:w-auto whitespace-nowrap' %>
      <% end %>
    </div>
  </div>

  <div id="admin-shorts__loading" hidden>
    <%= render State::Loading.new %>
  </div>

  <div class="overflow-x-auto x-rounded-box border border-base-300 bg-white shadow-xs" id="admin-shorts__content">
    <% if @shorts.any? %>
      <table class="x-table x-table-zebra">
        <thead>
          <tr class="bg-base-200">
            <th><%= t('admin.shorts.index.title') %></th>
            <th>Video</th>
            <th><%= t('admin.shorts.index.course_title') %></th>
            <th><%= t('admin.shorts.index.status') %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @shorts.each do |short| %>
            <tr>
              <td>
                <%= link_to_if current_user.allowed?('course.short.edit'), short.title, edit_admin_short_path(short), class: 'bs-a' %>
              </td>
              <td>
                <%= image_tag url_for(short.video.preview(resize_to_limit: [100, 100])), alt: '' if short.video.attached? %>
              </td>
              <td>
                <% if short.course %>
                  <%= link_to_if current_user.allowed?('course.course.edit'), short.course.title, course_path(short.course.course_code), class: 'bs-a' %>
                <% end %>
              </td>
              <td>
                <div class="x-badge <%= course_status_class(short.status) %>"><%= short.status.to_s %></div>
              </td>
              <td class="text-right whitespace-nowrap">
                <% if current_user.allowed? 'course.short.edit' %>
                  <%= link_to t(:'admin.shorts.index.edit'), edit_admin_short_path(short), class: 'x-btn x-btn-sm x-btn-outline w-24 justify-center' %>
                <% end %>
                <% if current_user.allowed? 'course.short.delete' %>
                  <%= link_to t(:'admin.shorts.index.delete'), admin_short_path(short), method: :delete, data: { confirm: t(:'admin.shorts.index.confirm_delete') }, class: 'x-btn x-btn-sm x-btn-outline w-24 justify-center' %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <%= render State::Empty.new(
        params[:autocomplete].present? || params[:status].present? ? t(:'admin.shorts.index.no_results') : t(:'admin.shorts.index.empty_state')) %>
    <% end %>
  </div>

  <%= will_paginate @shorts, renderer: PaginationRenderer %>
</section>
