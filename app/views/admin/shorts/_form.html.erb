<%= simple_form_for([:admin, short],
      html: {data: {'disable-on-submit': 'input[type="submit"]'}}) do |f| %>
  <%= f.error_notification %>

  <%= f.input :course_id, required: true, collection: CourseService::Course.all, include_blank: true %>

  <%= f.input :status,
            collection: CourseService::Short.statuses.keys.map { |k| [k.humanize, k] },
            required: true,
            selected: (short.status.presence || 'preparation') %>

  <%= f.hint t(:'admin.shorts.hint') %>
  <% CourseService::Short.localized_title_fields.each do |localized_title_field| %>
    <%= f.input localized_title_field, required: false %>
  <% end %>

  <% CourseService::Short.localized_description_fields.each do |localized_description_field| %>
    <%= f.input localized_description_field, required: false, as: :markdown %>
  <% end %>

  <div class="form-group">
    <div class="col-lg-offset-2 col-lg-10 col-md-offset-2 col-md-10">
      <%= render Form::FileUpload.new(f, :video,
            icon: 'video',
            title: t(:'admin.shorts.form.video.title'),
            hint: t(:'admin.shorts.form.video.hint'),
            button_label: t(:'admin.shorts.form.video.button'),
            accept: 'video/*',
            direct_upload: true) %>
    </div>
  </div>

  <%= f.submit (short.persisted? ? t('helpers.submit.short.update') : t('helpers.submit.short.create')),
        class: 'btn btn-primary',
        data: {disable_with: false} %>
  <%= link_to t(:'global.cancel'), admin_shorts_path, class: 'btn btn-default ml10' %>
<% end %>
