= render 'course/shared/admin_page_header', title: t(:'course.courses.create.edit')

.bs-container.sticky-container.x-card.bg-accent-25.text-accent-content.p-5
  .row
    .col-md-9
      = render 'form', course: @course

    .col-md-3.hidden-xs.hidden-sm.sticky-container__element
      .scrollspy-target
        ul.nav.news-nav
          - I18n.t(:'admin.courses.formgroups').each do |key, text|
            li: a href="#formgroup-#{key}" = text
