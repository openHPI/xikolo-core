.x-card.bg-accent-25.text-accent-content.p-5
  h3.h3 #{t :'quiz_submission.submission_deadline_passed.title'}:
  hr.divider.slim.alternative
  p.wmd-output
    == t(:'quiz_submission.submission_deadline_passed.msg')
