<section class="x-card bg-base-100 text-base-content" data-controller="quiz-steps">
  <div class="x-card-body">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
      <div class="flex min-w-0 items-center gap-3">
        <span
          class="
            bg-accent-75 text-accent-content flex size-11 shrink-0 items-center
            justify-center rounded-full
          "
          aria-hidden="true"
        >
          <%= helpers.pixelart_icon(@item_presenter.icon_class, css_class: 'size-6') %>
        </span>
        <h2
          class="x-card-title m-0 min-w-0 truncate text-lg font-medium sm:text-xl"
          lang="<%= @item_presenter.lang %>"
        >
          <%= @item_presenter.title %>
        </h2>
      </div>

      <div class="flex flex-wrap items-stretch">
        <% if show_points %>
          <div class="flex flex-col justify-center px-4 sm:px-6">
            <span class="text-xs text-base-content/60">
              <%= t('quiz_submission.card.total_points') %>
            </span>
            <span class="text-lg sm:text-xl">
              <% if show_results %>
                <%= t(:'quiz_submission.total_points', total_points: @submission.points.round(2), max_points: @my_result.max_points.round(2)) %>
                <% unless @submission.fudge_points.zero? %>
                  <span class="text-xs font-normal text-base-content/70">
                    <%= t(:'quiz_submission.fudge_points', fudge_points: @submission.fudge_points) %>
                  </span>
                <% end %>
              <% else %>
                <%= helpers.number_with_precision((@submission&.max_points || @quiz.max_points).round(2), precision: 2) %>
              <% end %>
            </span>
          </div>
        <% end %>

        <% if show_attempts %>
          <div class="flex flex-col justify-center px-4 sm:px-6 <%= divider if show_points %>">
            <span class="text-xs text-base-content/60">
              <%= t('quiz_submission.card.attempts_left') %>
            </span>
            <span class="text-lg sm:text-xl">
              <% if @item_presenter.current_unlimited_attempts %>
                <%= t('quiz_submission.card.unlimited') %>
              <% else %>
                <%= t('quiz_submission.card.attempts', count: @item_presenter.attempts_left) %>
              <% end %>
            </span>
          </div>
        <% end %>

        <% if show_time %>
          <div class="flex flex-col justify-center px-4 sm:px-6 <%= divider if show_points || show_attempts %>">
            <span class="text-xs text-base-content/60">
              <%= t('quiz_submission.card.time_left') %>
            </span>
            <div class="text-lg sm:text-xl">
              <% if @item_presenter.time_limited? %>
                <%= render Course::Countdown.new(@counter_end_timediff, total_secs: @quiz.current_time_limit_seconds, form: '#quiz_form') %>
              <% else %>
                <%= t('quiz_submission.card.unlimited') %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="ml-auto">
        <% if show_results %>
          <% if @item_presenter.allow_retake_quiz? %>
            <%= render 'items/quiz/retake_action', url: new_course_item_quiz_submission_path %>
          <% end %>
        <% elsif @item_presenter.quiz_submittable? %>
          <button
            type="submit"
            form="quiz_form"
            id="quiz_submit_button"
            class="x-btn x-btn-primary rounded-2xl font-semibold shadow-none"
          >
            <%= t("quiz_submission.submit.#{@item_presenter.exercise_type}") %>
          </button>
        <% end %>
      </div>
    </div>

    <% if show_results && @my_result.exam? %>
      <div class="mt-3">
        <% if @my_result.passed? %>
          <%= render Global::Callout.new(t(:'quiz_submission.exam_passed'), type: :success) %>
        <% elsif @item_presenter.allow_retake_quiz? %>
          <%= render Global::Callout.new(t(:'quiz_submission.exam_failed', percentage: @item_presenter.pass_percentage), type: :error) %>
        <% else %>
          <%= render Global::Callout.new(t(:'quiz_submission.exam_failed_final'), type: :error) %>
        <% end %>
      </div>
    <% end %>

    <hr class="my-4 border-0 border-t border-base-content/15">

    <% if show_results %>
      <div class="min-w-0">
        <div class="text-sm text-base-content/70">
          <%= t('quiz_submission.question_count', count: @quiz.questions.size) %>
        </div>

        <div class="mt-3 flex items-center gap-x-6 gap-y-4">
          <div class="min-w-0 flex-1">
            <%= render Quiz::Steps.new(@quiz.questions, statuses: question_statuses) %>
          </div>
          <div class="shrink-0" aria-hidden="true">
            <%= render Course::CircularProgress.new(@my_result.percentage, "#{@my_result.percentage}%") %>
          </div>
        </div>
      </div>
    <% else %>
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
        <span class="text-sm text-base-content/70">
          <%= t('quiz_submission.question_count', count: @quiz.questions.size) %>
        </span>
        <span
          id="quiz-answered-count"
          class="text-sm text-base-content/70"
          data-template="<%= t('quiz_submission.card.answered_count', answered: '%{answered}', total: '%{total}') %>"
          aria-live="polite"
        >
          <%= t('quiz_submission.card.answered_count', answered: 0, total: @quiz.questions.size) %>
        </span>
      </div>

      <div class="mt-3">
        <%= render Quiz::Steps.new(@quiz.questions, statuses: question_statuses) %>
      </div>
      <div class="warning-autosave mb-3" hidden>
        <%= render Global::Callout.new(t(:'quiz_submission.autosave_warning'), type: :warning) %>
      </div>
    <% end %>
  </div>
</section>
