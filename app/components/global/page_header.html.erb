<header class="<%= class_names('bg-(--page-header-bg) px-3.75 text-(--page-header-text) lg:px-16', header_classes) %>">
  <div class="<%= class_names('container mx-auto', 'md:grid md:grid-cols-2': visual?) %>">
    <div class="<%= class_names('min-w-0', padding_classes) %>">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
        <div class="flex min-w-0 flex-1 flex-col gap-2">
          <% if @breadcrumbs.any? %>
            <div class="-my-2">
              <%= render Global::Breadcrumbs.new(items: @breadcrumbs) %>
            </div>
          <% end %>

          <%= content_tag title_tag, @title, class: title_classes, lang: @lang %>

          <% if navigation? %>
            <div class="mt-6"><%= navigation %></div>
          <% end %>

          <% if @subtitle.present? %>
            <p class="text-xs wrap-anywhere sm:text-sm"><%= @subtitle %></p>
          <% end %>

          <%= content %>
        </div>

        <% if back_link? %>
          <div class="flex shrink-0 flex-col justify-center sm:items-end">
            <%= link_to @back_url, class: 'x-btn h-8 w-full rounded-2xl border-base-100 bg-base-100 px-3 text-xs font-semibold text-accent sm:h-10 sm:w-auto sm:px-4 sm:text-sm' do %>
              <%= render Global::FaIcon.new('chevron-left', css_classes: 'text-xs sm:text-sm') %>
              <%= t('components.page_header.back_to_course') %>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if item_header? %>
        <div class="mt-8"><%= item_header %></div>
      <% end %>
    </div>

    <% if visual? %>
      <div
        class="
          relative aspect-video min-w-0 overflow-hidden md:aspect-auto
          [&_img]:absolute [&_img]:inset-0 [&_img]:h-full [&_img]:w-full
          [&_img]:object-cover [&_picture]:block [&_picture]:h-full
        "
      >
        <%= visual %>
      </div>
    <% end %>
  </div>
</header>
