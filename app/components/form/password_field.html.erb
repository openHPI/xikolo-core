<div class="relative" data-controller="password-toggle"
     data-password-toggle-show-label-value="<%= t(:'components.password_field.show') %>"
     data-password-toggle-hide-label-value="<%= t(:'components.password_field.hide') %>">
  <%= @form.password_field @attribute, **@options,
        class: 'x-input rounded-2xl w-full pr-10',
        data: {'password-toggle-target': 'input'} %>
  <button type="button"
          aria-label="<%= t(:'components.password_field.show') %>"
          class="absolute inset-y-0 right-0 flex items-center pr-3 text-base-content/50"
          data-action="password-toggle#toggle">
    <span data-password-toggle-target="icon"><%= helpers.pixelart_icon 'eye', css_class: 'w-5 h-5' %></span>
    <span data-password-toggle-target="icon" hidden><%= helpers.pixelart_icon 'eye-off', css_class: 'w-5 h-5' %></span>
  </button>
</div>
