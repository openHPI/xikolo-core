<div class="max-w-main-content mx-auto px-6 md:px-0">
  <h2 class="text-2xl"><%= t(:'home.level_selector.headline') %></h2>
  <div class="grid grid-cols-1 md:grid-cols-3 pt-6 pb-6 items-end">
    <div class="x-card bg-base-100 text-base-content border
     border-accent-50 hover:bg-accent-50 md:h-70">
      <div class="x-card-body">
        <h2 class="x-card-title"><%= t(:'home.level_selector.sections').first[:label] %></h2>
        <p class="text-base leading-7"><%= t(:'home.level_selector.sections').first[:text] %></p>
        <div class="x-card-actions justify-start">
          <%= link_to t(:'home.level_selector.sections').first[:link_url], class: "x-btn x-btn-outline rounded-2xl", aria: {label: t(:"home.level_selector.link_text")} do %>
            <%= t(:"home.level_selector.link_text") %>
            <%= helpers.pixelart_icon('arrow-right', css_class: 'size-3.5') %>
          <% end %>
        </div>
      </div>
    </div>
    <div class="x-card bg-base-100 text-base-content border
     border-secondary-50 hover:bg-secondary-50 md:-ml-5 md:h-80">
      <div class="x-card-body">
        <h2 class="x-card-title"><%= t(:'home.level_selector.sections').second[:label] %></h2>
        <p class="text-base leading-7"><%= t(:'home.level_selector.sections').second[:text] %></p>
        <div class="x-card-actions justify-start">
          <%= link_to t(:'home.level_selector.sections').second[:link_url], class: "x-btn x-btn-outline rounded-2xl", aria: {label: t(:"home.level_selector.link_text")} do %>
            <%= t(:"home.level_selector.link_text") %>
            <%= helpers.pixelart_icon('arrow-right', css_class: 'size-3.5') %>
          <% end %>
        </div>
      </div>
    </div>
    <div class="x-card bg-base-100 text-base-content border
     border-primary-250 hover:bg-primary-250 md:-ml-5 md:h-90">
      <div class="x-card-body">
        <h2 class="x-card-title"><%= t(:'home.level_selector.sections').third[:label] %></h2>
        <p class="text-base leading-7"><%= t(:'home.level_selector.sections').third[:text] %></p>
        <div class="x-card-actions justify-start">
          <%= link_to t(:'home.level_selector.sections').third[:link_url], class: "x-btn x-btn-outline rounded-2xl", aria: {label: t(:"home.level_selector.link_text")} do %>
            <%= t(:"home.level_selector.link_text") %>
            <%= helpers.pixelart_icon('arrow-right', css_class: 'size-3.5') %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
