    "@hotwired/turbo-rails": "^8.0.20",
    "@openhpi/quiz-recap": "^3.1.0",
    "@openhpi/xikolo-video-player": "^3.1.1",
    "@rails/activestorage": "^8.1.300",
    "@rails/ujs": "^7.1.3-4",
    "@sentry/browser": "^10.28.0",
    "@toast-ui/editor": "^3.2.2",
    "@videojs/hlsjs-video": "10.4.0",
    "@videojs/html": "10.4.0",
    "bootstrap": "3.4.1",
    "dropzone": "^6.0.0",
    "flatpickr": "^4.6.13",
    "html5sortable": "^0.14.0",
    "i18n-js": "^4.5.0",
    "jquery": "^2.2.4",
    "js-cookie": "^3.0.0",
    "list.js": "^2.3.1",
    "luxon": "^3.2.1",
    "markdown-it": "^15.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sass": "^1.97.2",
    "sweetalert2": "^11.4.8",
    "table-builder": "^2.1.1",
    "tom-select": "^2.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@herb-tools/formatter": "^0.11.0",
    "@herb-tools/linter": "^0.11.0",
    "@stoplight/cli": "^6.0.2354",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/hotwired__turbo": "^8.0.6",
    "@types/jqueryui": "^1.12.20",
    "@types/list.js": "^2",
    "@types/luxon": "^3.4.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "daisyui": "^5.5.14",
    "editorconfig-checker": "^7.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "markdownlint": "^0.42.0",
    "markdownlint-cli": "^0.50.0",
    "prettier": "^3.8.1",
    "stylelint": "^18.0.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-recommended-scss": "^16.0.2",
    "stylelint-config-two-dash-bem": "^1.0.0",
    "tailwindcss": "^4.1.18",
    "typescript-eslint": "^8.65.0"
  },
  "scripts": {
    "build:tailwind": "bunx @tailwindcss/cli -i ./app/assets/stylesheets/tailwind/input.css -o ./app/assets/builds/tailwind.css --minify",
    "build": "bun bun.config.js",
    "format": "prettier --write .",
    "tsc:check": "tsc",
    "lint:css": "stylelint --allow-empty-input 'app/assets/**/*.{css,scss}'",
    "lint:format": "prettier --check .",
    "lint:herb": "herb-lint '**/*.html.erb'",
    "lint:js": "eslint app/javascript",
    "lint:md": "markdownlint '**/*.{md,md.erb}' .",
    "postinstall": "husky",
    "herb:format": "herb-format",
    "herb:format:check": "herb-format --check",
    "build:css": "bun run build:tailwind && ./bin/build_sass --stop-on-error",
    "watch:sass": "./bin/build_sass --watch"
  },
  "lint-staged": {
    "*": [
      "prettier --ignore-unknown --write",
      "editorconfig-checker"
    ],
    "*.rb": "bundle exec rubocop --force-exclusion --autocorrect",
    "*.html.erb": "herb-lint",
    "*.slim": "bundle exec slim-lint",
    "*.{js,ts,jsx,tsx,mjs}": "eslint --fix",
    "*.{css,scss,sass}": "stylelint --fix --allow-empty-input",
    "*.{md,md.erb}": "markdownlint --fix"
  },
  "packageManager": "bun@1.3.9"
}
